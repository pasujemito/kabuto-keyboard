{
  "version": 2,
  "randomizedDelay": true,
  "workflows": [
    {"id":"walk", "name":"Walk forward", "kind":"nano", "steps":[
      {"type":"down","key":"W"}, {"type":"delay","ms":700}, {"type":"up","key":"W"}
    ]},
    {"id":"attack", "name":"Attack", "kind":"nano", "steps":[
      {"type":"key","key":"A","hold":60}, {"type":"delay","ms":300}
    ]},
    {"id":"heal", "name":"Heal", "kind":"nano", "steps":[
      {"type":"key","key":"H","hold":60}, {"type":"delay","ms":800}
    ]},
    {"id":"approach", "name":"Approach and attack", "kind":"micro", "steps":[
      {"type":"call","workflow":"walk"}, {"type":"call","workflow":"attack"}
    ]},
    {"id":"burst", "name":"Attack burst", "kind":"micro", "steps":[
      {"type":"loop","count":2}, {"type":"call","workflow":"attack"}, {"type":"endloop"}
    ]},
    {"id":"recover", "name":"Recover and move", "kind":"micro", "steps":[
      {"type":"call","workflow":"heal"}, {"type":"call","workflow":"walk"}
    ]}
  ],
  "layers": [{"name":"Workflows", "keys":[
    {"name":"Controller", "trigger":"toggle", "steps":[
      {"type":"random","avoidRecent":1,"choices":[
        {"workflow":"approach","weight":3},
        {"workflow":"burst","weight":2},
        {"workflow":"recover","weight":1}
      ]},
      {"type":"delay","ms":500}
    ]}
  ]}]
}
